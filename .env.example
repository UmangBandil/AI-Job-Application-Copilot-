# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/jobcopilot
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/jobcopilot

# Auth
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM
# LLM_PROVIDER: "ollama" (local, no key needed) | "openai" | "anthropic" | empty = auto-detect
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
LLM_TIMEOUT_SECONDS=120
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Cloud model overrides (optional; sensible defaults used when empty)
# OPENAI_MODEL=gpt-4o
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Job Board APIs
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# App
APP_NAME=AI Job Application Copilot
APP_URL=http://localhost:3000
